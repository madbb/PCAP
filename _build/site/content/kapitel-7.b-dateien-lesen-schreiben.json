17\n\n# errno in der Praxis -- gezielt auf bestimmte Fehler reagieren\ndef lade_heldendaten(pfad):\n    try:\n        with open(pfad, 'r', encoding='utf-8') as f:\n            return f.read()\n    except OSError as e:\n        if e.errno == errno.ENOENT:\n            print(f'Datei nicht gefunden: {pfad}')\n        elif e.errno == errno.EACCES:\n            print(f'Kein Lesezugriff auf: {pfad}')\n        else:\n            print(f'I/O-Fehler {e.errno}: {e.strerror}')\n        return None\n\nlade_heldendaten('nicht_vorhanden.txt')","key":"sasElQgCqW"},{"type":"outputs","id":"E1EiRVQJDnyfX94kKQ_-w","children":[],"key":"N4WJr2pcK8"}],"key":"fdcRfUisgr"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 5.5","key":"a9bGpMyZ6t"}],"key":"XNPLXNzLcu"},{"type":"text","value":" 5. bytearray -- veraenderlicher Byte-Puffer","key":"phfQHlZ6gZ"}],"key":"HD8hDyrcbt"}],"key":"PRNrNp3Qzj"}],"key":"wqN4LrIV60"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Im Binaermodus arbeitet man mit ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VcluXp419X"},{"type":"inlineCode","value":"bytes","position":{"start":{"line":1,"column":1},"end":{"lin