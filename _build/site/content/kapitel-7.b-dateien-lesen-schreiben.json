repr(zeile2))   # 'Lyria,Magierin,80\\n'\n\n# Schleife mit readline() -- leerer String signalisiert Dateiende\nwith open('helden.txt', 'r', encoding='utf-8') as f:\n    while True:\n        zeile = f.readline()\n        if zeile == '':    # Dateiende\n            break\n        print(zeile.strip())","key":"QOp3bsMgSJ"},{"type":"outputs","id":"WD8MZ30npYi4u4yqvMa0I","children":[],"key":"fI4toUqi1c"}],"key":"Ux7Of3jswN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# readlines() -- alle Zeilen als Liste\nwith open('helden.txt', 'r', encoding='utf-8') as f:\n    zeilen = f.readlines()\n    print(zeilen)    # ['Aldric,Krieger,100\\n', 'Lyria,...]\n    print(type(zeilen))  # list\n\n# CSV-Daten verarbeiten\nwith open('helden.txt', 'r', encoding='utf-8') as f:\n    for zeile in f.readlines():\n        teile = zeile.strip().split(',')\n        print(f'{teile[0]} ist ein {teile[1]} mit {teile[2]} HP')","key":"V4OeFzl4jg"},{"type":"outputs","id":"IRIb-CZXSMyNlNGqUnTnL","children":[],"key":"YhjWNaE0Lj"}],"key":"WYHjhz2cYA"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0d1f2d","borderLeft":"3px solid #1e4d6b","borderRadius":"3px","padding":"0.55em 1em","margin":"1.5rem 0 0.9rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(0.9rem,1.8vw,1.05rem)","fontWeight":"600","color":"#c5cae9","letterSpacing":"-0.005em"},"children":[{"type":"span","style":{"fontSize":"0.6rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#80cbc4","background":"rgba(128,203,196,0.1)","border":"1px solid rgba(128,203,196,0.25)","borderRadius":"3px","padding":"0.15em 0.5em","marginRight":"0.65em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP-Falle","key":"lwLcUz2SgB"}],"key":"zOFHMg7YRA"},{"type":"text","value":" Der Cursor -- zweimaliges Lesen liefert leeren String","key":"qeYV7adKFY"}],"key":