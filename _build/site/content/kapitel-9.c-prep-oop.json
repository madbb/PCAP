int(b.gilde)             # Goldene Flamme -- Klassenvariable unveraendert\nprint(Held.gilde)          # Goldene Flamme -- Klasse unveraendert\nprint(a.__dict__)          # {'name': 'Aldric', 'gilde': 'Freie Klingen'}\nprint(b.__dict__)          # {'name': 'Lyria'}  -- kein gilde-Eintrag","key":"GOnfq595fE"},{"type":"outputs","id":"3dSHoQ26ELpYhBZC9snHK","children":[],"key":"WDr1pObvAf"}],"key":"BU8PEY6wuk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Tier:\n    pass\n\nclass Held(Tier):\n    pass\n\nclass Krieger(Held):\n    pass\n\nk = Krieger()\n\n# __name__ nur an der Klasse\nprint(Krieger.__name__)      # 'Krieger'\ntry:\n    print(k.__name__)        # AttributeError!\nexcept AttributeError as e:\n    print(f'AttributeError: {e}')\nprint(type(k).__name__)      # 'Krieger' -- Umweg\n\n# isinstance vs. type\nprint(type(k) == Krieger)    # True\nprint(type(k) == Held)       # False -- type prueft nur direkte Klasse\nprint(isinstance(k, Krieger)) # True\nprint(isinstance(k, Held))    # True  -- Vererbungskette!\nprint(isinstance(k, Tier))    # True\n\n# issubclass\nprint(issubclass(Krieger, Held))     # True\nprint(issubclass(Krieger, Krieger))  # True -- sich selbst!","key":"AQTXyK1jv7"},{"type":"outputs","id":"pG6WCn87C3sj1m70MAzDH","children":[],"key":"FwKcTMHrTh"}],"key":"Y45pFMDIok"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class A:\n    def methode(self): return 'A'\n\nclass B(A):\n    def methode(self): return 'B'\n\nclass C(A):\n    def methode(self): return 'C'\n\nclass D(B, C):\n    pass\n\n# MRO: D -> B -> C -> A -> object\nprint([k.__name__ for k in D.__mro__])\n\nd = D()\nprint(d.methode())   # 'B' -- B kommt in MRO zuerst\n\n# is vs. ==\na1 = Held('x') if False else A()\na2 = A()\na3 = a1\n\na1 = A(); a2 = A(); a3 = a1\nprint(a1 is a2)   # False -- verschiedene Objekte\nprint(a1 is a3)   # True  -- dieselbe Referenz\nprint(a1 == a2)   # False -- kein __eq__ definiert, faellt auf 'is' zurueck","key":"lQIP5pr73m"},{"type":"outputs","id":"FXrytHTi8yUKtgvxvF3Aj","children":[],"key":"TtTsd7Tya8"}],"key":"EaROrn6w6n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Held:\n    def __init__(self):\n        self.name    = 'Aldric'   # oeffentlich\n        self._rang   = 'Rekrut'   # geschuetzt (Konvention)\n        self.__code  = 'geheim'   # privat -- Name Mangling!\n\nh = Held()\nprint(h.name)            # Aldric\nprint(h._rang)           # Rekrut  -- geht, aber bitte nicht\n\ntry:\n    print(h.__code)      # AttributeError!\nexcept AttributeError:\n    print('__code nicht direkt erreichbar')\n\n# Echter Name nach Mangling:\nprint(h._Held__code)     # geheim -- so heisst es wirklich\nprint(h.__dict__)        # zeigt _Held__code","key":"gwQCBn2CPz"},{"type":"outputs","id":"xeOnL-mwk29Ahu0Zlh8xn","children":[],"key":"lxijFz8bou"}],"key":"qIFhoFr3h0"}],"key":"hsbsbRPR69"},"references":{"cite":{"order":[],"data":{}}}}