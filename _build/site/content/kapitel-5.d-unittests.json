e(None)\n        self.assertIsNotNone(42)\n\n        # Enthaltensein\n        self.assertIn(3, [1, 2, 3, 4])\n        self.assertNotIn('java', ['python', 'rust'])\n\n        # Typ\n        self.assertIsInstance(3.14, float)\n        self.assertIsInstance([1, 2], list)\n\n        # Kommazahlen\n        self.assertAlmostEqual(0.1 + 0.2, 0.3, places=10)\n\n    def test_raises_als_context_manager(self):\n        # assertRaises als Context Manager -- empfohlene Form\n        with self.assertRaises(ValueError):\n            int('kein int')\n\n        with self.assertRaises(TypeError):\n            'text' + 42\n\n        with self.assertRaises(KeyError):\n            {}['nicht_vorhanden']\n\nunittest.main(argv=[''], exit=False, verbosity=2)","key":"VlGA6ZJTwY"},{"type":"outputs","id":"QdBZ99rk3bmRpPji2nQVX","children":[],"key":"cABYNjrZKO"}],"key":"TRGMI2IB7V"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"IMG9wZy8Pc"}],"key":"w7SzodcOSK"},{"type":"text","value":" 4. setUp() und tearDown()","key":"WSdxTmH6tm"}],"key":"gOubzMEHTU"}],"key":"ezEQ4AJXu9"}],"key":"MQsoVFbHoa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"setUp()","positi