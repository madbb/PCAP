\n    return a / b\n\ndef ist_palindrom(text):\n    bereinigt = text.lower().replace(' ', '')\n    return bereinigt == bereinigt[::-1]\n\n# --- Testklasse ---\nclass TestRechner(unittest.TestCase):\n\n    def test_addiere_positiv(self):\n        # Arrange\n        a, b = 3, 5\n        # Act\n        ergebnis = addiere(a, b)\n        # Assert\n        self.assertEqual(ergebnis, 8)\n\n    def test_addiere_negativ(self):\n        self.assertEqual(addiere(-1, -2), -3)\n\n    def test_addiere_float(self):\n        self.assertAlmostEqual(addiere(0.1, 0.2), 0.3, places=10)\n\n    def test_dividiere_ganzzahl(self):\n        self.assertEqual(dividiere(10, 2), 5.0)\n\n    def test_dividiere_durch_null_wirft_exception(self):\n        with self.assertRaises(ValueError):\n            dividiere(5, 0)\n\n\nclass TestPalindrom(unittest.TestCase):\n\n    def test_einfaches_palindrom(self):\n        self.assertTrue(ist_palindrom('racecar'))\n\n    def test_kein_palindrom(self):\n        self.assertFalse(ist_palindrom('python'))\n\n    def test_grosskleinschreibung_ignoriert(self):\n        self.assertTrue(ist_palindrom('Anna'))\n\n    def test_mit_leerzeichen(self):\n        self.assertTrue(ist_palindrom('never odd or even'))\n\n\n# In Notebooks so ausfuehren:\nunittest.main(argv=[''], exit=False, verbosity=2)","key":"zYcQ8thGIP"},{"type":"outputs","id":"kXib0PncOCEvjtIJ3A_df","children":[],"key":"PYruwoBPp2"}],"key":"vNMjPkUM6n"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px so