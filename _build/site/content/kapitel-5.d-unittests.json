urn list(self._notizen)\n\n    def anzahl(self):\n        return len(self._notizen)\n\n\nclass TestNotizblock(unittest.TestCase):\n\n    def setUp(self):\n        # Vor jedem Test: frischer Notizblock mit zwei Eintraegen\n        self.block = Notizblock()\n        self.block.hinzufuegen('Erste Notiz')\n        self.block.hinzufuegen('Zweite Notiz')\n\n    def tearDown(self):\n        # Nach jedem Test: hier nichts noetig\n        # Bei Datenbankverbindungen oder Dateien wuerde man hier aufraeumen\n        pass\n\n    def test_anfangszustand(self):\n        self.assertEqual(self.block.anzahl(), 2)\n\n    def test_hinzufuegen(self):\n        self.block.hinzufuegen('Dritte Notiz')\n        self.assertEqual(self.block.anzahl(), 3)\n        self.assertIn('Dritte Notiz', self.block.alle())\n\n    def test_leere_notiz_verboten(self):\n        with self.assertRaises(ValueError):\n            self.block.hinzufuegen('   ')  # nur Leerzeichen\n\n    def test_loeschen(self):\n        self.block.loeschen(0)\n        self.assertEqual(self.block.anzahl(), 1)\n        self.assertNotIn('Erste Notiz', self.block.alle())\n\n    def test_loeschen_ungueltig(self):\n        with self.assertRaises(IndexError):\n            self.block.loeschen(99)\n\n    def test_alle_gibt_kopie(self):\n        # alle() soll eine Kopie zurueckgeben, nicht die interne Liste\n        liste = self.block.alle()\n        liste.append('manipuliert')\n        self.assertEqual(self.block.anzahl(), 2)  # intern unveraendert\n\n\nunittest.main(argv=[''], exit=False, verbosity=2)","key":"tWBTzooJfI"},{"type":"outputs","id":"eaRBdXNFPltuXibN5Uft7","children":[],"key":"tF7jHqP1W6"}],"key":"navPm14kTF"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fo