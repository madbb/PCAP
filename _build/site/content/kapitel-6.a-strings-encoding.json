euge um zwischen Zeichen und Unicode-Codepoints zu wechseln. Sie werden in der PCAP-Pruefung haeufig eingesetzt -- oft in Kombination mit String-Operationen oder Vergleichen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Myqo2zVeLl"}],"key":"y6cj6oNgQ8"}],"key":"AxMp2Q8Uio"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ord() und chr() sind Umkehrfunktionen\nprint(ord('A'))         # 65\nprint(chr(ord('A')))    # 'A'  -- hin und zurueck\n\n# Warum ist das nuetzlich? Weil Zeichenmanipulation oft ueber Zahlen geht\n\n# Beispiel: Naechsten Buchstaben im Alphabet\ndef naechster_buchstabe(zeichen):\n    return chr(ord(zeichen) + 1)\n\nprint(naechster_buchstabe('A'))   # B\nprint(naechster_buchstabe('Z'))   # [  -- Vorsicht: nach Z kommt kein A mehr!\n\n# Beispiel: Gross- in Kleinbuchstaben umwandeln (manuell)\ndef zu_kleinbuchstabe(zeichen):\n    if 'A' <= zeichen <= 'Z':\n        return chr(ord(zeichen) + 32)   # Abstand zwischen A(65) und a(97) ist 32\n    return zeichen\n\nprint(zu_kleinbuchstabe('H'))   # h\nprint(zu_kleinbuchstabe('a'))   # a  -- unveraendert","key":"H5ZjOFjzY3"},{"type":"outputs","id":"cibCgmqtaghLMKbi5_wyO","children":[],"key":"p6BSVgIBmD"}],"key":"D7sviG8HJy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# PCAP-relevantes Wissen: Codepoint-Reihenfolge bestimmt String-Vergleiche\nprint('A' < 'B')    # True  -- 65 < 66\nprint('Z' < 'a')    # True  -- 90 < 97 -- Grossbuchstaben kommen vor Kleinbuchstaben!\nprint('z' < 'A')    # False\n\n# Das erklaert warum sorted() ohne key Grossbuchstaben zuerst sortiert\nwoerter = ['banane', 'Apfel', 'kirsche', 'Dattel']\nprint(sorted(woerter))            # ['Apfel', 'Dattel', 'banane', 'kirsche']\nprint(sorted(woerter, key=str.lower))  # ['Apfel', 'banane', 'Dattel', 'kirsche']","key":"CdVdpz5nto"},{"type":"outputs","id":"oGmIYnkMfKNTi05192V5n","children":[],"key":"D4iSMdklYi"}],"key":"pyFj142We9"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 3.2","key":"bisKyzdWUj"}],"key":"dUCwpr8BVp"},{"type":"text","value":" 5. Indexing, Slicing und Iteration","key":"up0O2ZVoor"}],"key":"ErOuIRlvFL"}],"key":"aTPI0T7afO"}],"key":"cMGLnstnqo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ein String ist in Python eine ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lpJq6WdPWh"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"geordnete, unveraenderliche Folge von Zeichen","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hqyPR2ljQu"}],"key":"Vb9OxJKKgf"},{"type":"text","value":". Geordnet bedeutet: Jedes Zeichen hat eine Position -- den Index. Unveraenderlich (immutable) bedeutet: Man kann einen String nicht an Ort und Stelle veraendern -- jede Manipulation erzeugt einen neuen String.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Y0nULZ4hw6"}],"key":"AGr2eqgFtC"}],"key":"lGnIJlu7yx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"text = 'Python'\n#       0 1 2 3 4 5   positiver Index\n#      -6-5-4-3-2-1   negativer Index\n\n# Einzelne Zeichen -- Indexzugriff\nprint(text[0])    # P  -- erstes Zeichen\nprint(text[5])    # n  -- letztes Zeichen\nprint(text[-1])   # n  -- letztes Zeichen (von hinten)\nprint(text[-2])   # o  -- vorletztes Zeichen\n\n# Slicing: text[start:stop:schritt]\nprint(text[0:3])   # Pyt  -- Index 0, 1, 2 (stop ist exklusiv!)\nprint(text[2:])    # thon -- von Index 2 bis Ende\nprint(text[:4])    # Pyth -- von Anfang bis Index 3\nprint(text[::2])   # Pto  -- jedes zweite Zeichen\nprint(text[::-1])  # nohtyP -- rueckwaerts","key":"AQoaHAe5g8"},{"type":"outputs","id":"nrakIGxTu7YOzLCkX6r24","children":[],"key":"Zz6MlUffwA"}],"key":"IOka3eOoTZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Strings sind immutable -- direktes Aendern ist nicht moeglich\ntext = 'Python'\ntry:\n    text[0] = 'J'   # TypeError!\nexcept TypeError as e:\n    print(f'TypeError: {e}')\n\n# Stattdessen: neuen String erzeugen\nneuer_text = 'J' + text[1:]\nprint(neuer_text)   # Jython\nprint(text)         # Python -- Original unveraendert","key":"sinV8nP2JB"},{"type":"outputs","id":"q0KixwDVv9IxSTN5tmAkK","children":[],"key":"eqf0HTJW7E"}],"key":"toRoipQzdX"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRig