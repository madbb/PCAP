', 'Held hat 42 HP')\nif m:\n    print(m.group())   # '42' -- das Match-Objekt\n    print(m.start())   # 9   -- Startposition\n    print(m.end())     # 11  -- Endposition\n\n# re.match() -- nur am ANFANG des Strings\nprint(re.match(r'\\d+', '42 HP'))    # Match -- beginnt mit Zahlen\nprint(re.match(r'\\d+', 'HP 42'))    # None  -- beginnt nicht mit Zahlen\n\n# re.findall() -- alle Vorkommen als Liste\nprint(re.findall(r'\\d+', 'HP:100 MP:80 STR:15'))  # ['100', '80', '15']\n\n# re.sub() -- ersetzen\nprint(re.sub(r'\\d+', 'X', 'HP:100 MP:80'))  # 'HP:X MP:X'\n\n# re.split() -- aufteilen an Muster\nprint(re.split(r'[,;|]', 'Aldric,Lyria;Thorn|Mira'))  # ['Aldric', 'Lyria', 'Thorn', 'Mira']","key":"LppUS1WIAP"},{"type":"outputs","id":"jgf-KDpMVic7p48KCoK96","children":[],"key":"cR0Ucu3WmY"}],"key":"uVrCsoxfLy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\n# ^ und $ -- Anfang und Ende des Strings\nprint(re.search(r'^Held', 'Held Aldric'))    # Match -- beginnt mit 'Held'\nprint(re.search(r'^Held', 'Der Held'))       # None  -- beginnt nicht mit 'Held'\nprint(re.search(r'\\d+$', 'Level 42'))        # Match -- endet mit Zahlen\nprint(re.search(r'\\d+$', '42 Punkte'))       # None  -- endet nicht mit Zahlen\n\n# \\b -- Wortgrenze: unterscheidet 'art' in 'Wart' von 'art' als eigenem Wort\ntext = 'Kunst ist eine Kunstform'\nprint(re.findall(r'\\bKunst\\b', text))   # ['Kunst'] -- nur ganzes Wort\nprint(re.findall(r'Kunst', text))        # ['Kunst', 'Kunst'] -- auch in 'Kunstform'","key":"An2d29uQEw"},{"type":"outputs","id":"SF0wT8s-dEMUpI0EBZBz1","children":[],"key":"bQF75Rc7eS"}],"key":"TUvT20OjEK"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2