e Werte\nprint(list(gen))    # [0, 1, 2, 3, 4]\n\n# Zweite Iteration: leer! Generator ist erschoepft\nprint(list(gen))    # []  -- nichts mehr\n\n# Loesung: neuen Generator erstellen\ngen = (x for x in range(5))  # neues Objekt\nprint(list(gen))    # [0, 1, 2, 3, 4]","key":"aUlTq0stbh"},{"type":"outputs","id":"Nte7b2NgbrspvpfbJo776","children":[],"key":"uRSYf0knIv"}],"key":"c2xGW7ffRW"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"viKCRotJHW"}],"key":"TZacIBB2uF"},{"type":"text","value":" 4. Generator-Funktionen mit yield","key":"rmxKVuz4Va"}],"key":"mYJ4QPEs22"}],"key":"FtpQ5LaYJs"}],"key":"UjE7noNiZY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generator Expressions sind praktisch fuer einfache Faelle. Fuer komplexere Logik gibt es ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RzclYIKUgC"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generator-Funktionen","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lrqSSHzAhB"}],"key":"XCk6SbM22I"},{"type":"text","value":" -- normale Funktionen die 