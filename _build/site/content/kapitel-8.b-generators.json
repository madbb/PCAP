otebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Der Generator ist winzig im Speicher -- er speichert nicht die Werte, sondern nur die Anweisung wie die Werte berechnet werden. Werte entstehen erst beim Abruf.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YlFF5D81Zo"}],"key":"SKob3Rahbw"}],"key":"Mv19ddeFXj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Generator direkt in Funktionen -- ohne extra Klammern\n# sum(), min(), max(), any(), all() akzeptieren direkt Generators\n\nsumme = sum(x**2 for x in range(1_000_000))   # kein Speicherproblem\nprint(f'Summe: {summe:,}')\n\nmaximum = max(x**2 for x in range(100))\nprint(f'Maximum: {maximum}')\n\n# any() / all() mit Generator -- bricht ab sobald Ergebnis feststeht\nhelden_hp = [100, 45, 80, 12, 60, 95]\nprint(any(hp < 20 for hp in helden_hp))    # True -- sobald 12 gefunden, fertig\nprint(all(hp > 0  for hp in helden_hp))    # True -- alle groesser als 0","key":"Br2zdiZPSV"},{"type":"outputs","id":"SA5ERznNNhH3YRuoopm1n","children":[],"key":"vRFX2Njg9o"}],"key":"ALvB1DVGme"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","