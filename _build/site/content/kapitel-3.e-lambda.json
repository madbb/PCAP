m","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 5.2","key":"pYdwBgDRXK"}],"key":"XdmR1FXUs8"},{"type":"text","value":" 3. Lambda als Argument -- der Hauptanwendungsfall","key":"aKvSNikdUn"}],"key":"EiEGYfbRe0"}],"key":"PUAWrUitUl"}],"key":"mTxOZg7IZ8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Der eigentliche Nutzen von Lambda liegt darin, direkt an der Stelle wo eine Funktion gebraucht wird eine zu schreiben -- ohne sie vorher benennen zu muessen. Das macht den Code oft lesbarer, weil der Gedanke nicht aufgesplittet wird:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XbzzdU213L"}],"key":"YyDd2SWbR2"}],"key":"dNs1TUgntx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"personen = [\n    {'name': 'Alice', 'alter': 30},\n    {'name': 'Bob',   'alter': 25},\n    {'name': 'Carol', 'alter': 35},\n]\n\n# Ohne Lambda -- Funktion extra definieren\ndef nach_alter(p): return p['alter']\nsortiert = sorted(personen, key=nach_alter)\n\n# Mit Lambda -- direkt an Ort und Stelle\nsortiert = sorted(personen, key=lambda p: p['alter'])\n\n# Beide Varianten liefern dasselbe Ergebnis\nfor p in sortiert:\n    print(p['name'], p['alter'])","key":"ZY79oUBKuG"},{"type":"outputs","id":"jrR6WziC6IMlGIrFFW8-L","children":[],"key":"FJlwYG2mYx"}],"key":"MqfSvr9h2K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Lambda funktioniert auch mit min(), max() und allen anderen\n# hoeherwertigen Funktionen die ein key-Argument kennen\n\nwoerter = ['Banane', 'Apfel', 'Kiwi', 'Ananas']\n\n# Nach Laenge sortieren\nprint(sorted(woerter, key=lambda w: len(w)))\n\n# Kuerzestes Wort\nprint(min(woerter, key=lambda w: len(w)))\n\n# Nach letztem Buchstaben sortieren\nprint(sorted(woerter, key=lambda w: w[-1]))\n\n# Nach zwei Kriterien: erst Laenge, dann alphabetisch\nprint(sorted(woerter, key=lambda w: (len(w), w)))","key":"aRxRyZqd8b"},{"type":"outputs","id":"9x5z2bTbk4WsRpL1fNV0_","children":[],"key":"ZVqUhbuXwQ"}],"key":"enPBw2wpzm"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 5.2","key":"CkRYudHbvk"}],"key":"hnQXNdyBk6"},{"type":"text","value":" 4. Die Grenzen von Lambda","key":"i9pO7Nb2Nb"}],"key":"RE5gNohOdq"}],"key":"L2o9mueCDk"}],"key":"pzaYPDRGzG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Lambda ist bewusst eingeschraenkt. Es kann nur einen ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yi2LvzBftv"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"einzigen Ausdruck","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aXFGq6Fbdl"}],"key":"OF8Z2R9DN1"},{"type"