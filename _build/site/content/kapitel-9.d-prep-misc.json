table":true,"value":"# Closure-Schleifenfalle\nfunktionen = []\nfor i in range(3):\n    funktionen.append(lambda: i)   # Referenz auf i!\n\nprint([f() for f in funktionen])  # [2, 2, 2] -- alle sehen i=2!\n\n# Fix: Default-Parameter friert Wert ein\nfunktionen = []\nfor i in range(3):\n    funktionen.append(lambda i=i: i)  # i=i: Wert wird kopiert\n\nprint([f() for f in funktionen])  # [0, 1, 2]\n\n# nonlocal\ndef zaehler():\n    n = 0\n    def erhoehe():\n        nonlocal n   # ohne nonlocal: UnboundLocalError\n        n += 1\n        return n\n    return erhoehe\n\nz = zaehler()\nprint(z(), z(), z())   # 1 2 3","key":"IlYcHlKFsR"},{"type":"outputs","id":"G3GOWktVBynZd4_McPhsL","children":[],"key":"jncgcNtDGC"}],"key":"HwjJ0kvG26"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Text vs. Binaer\nwith open('test.txt', 'w') as f:\n    f.write('Hallo')\n\nwith open('test.txt', 'r') as f:   # Textmodus\n    print(type(f.read()))           # <class 'str'>\n\nwith open('test.txt', 'rb') as f:  # Binaermodus\n    print(type(f.read()))           # <class 'bytes'>\n\n# Modus 'w' loescht sofort\nwith open('test.txt', 'w') as f:\n    pass   # nichts schreiben -- aber alter Inhalt ist weg!\nwith open('test.txt', 'r') as f:\n    print(repr(f.read()))   # ''  -- leer!\n\n# Cursor-Falle\nwith open('test.txt', 'w') as f:\n    f.write('abc')\nwith open('test.txt', 'r') as f:\n    print(f.read())    # 'abc'\n    print(f.read())    # ''  -- Cursor am Ende!","key":"cEVZJb500H"},{"type":"outputs","id":"8fl8e5-nFm2l14QqaGreh","children":[],"key":"CWNdbDXymG"}],"key":"TB1Kofs7zg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# bytes vs. bytearray\nb  = bytes([65, 66, 67])      # unveraenderlich\nba = bytearray([65, 66, 67])  # veraenderlich\n\n# Indexzugriff gibt int!\nprint(b[0])     # 65  -- nicht b'A'\nprint(ba[0])    # 65\nprint(b[0:1])   # b'A' -- Slicing gibt bytes\n\n# bytearray ist veraenderlich\nba[0] = 97   # 'a' statt 'A'\nprint(ba)    # bytearray(b'aBC')\n\ntry:\n    b[0] = 97   # TypeError!\nexcept TypeError as e:\n    print(f'TypeError: {e}')","key":"oKLDcFlGdv"},{"type":"outputs","id":"_EUljy2kOAYaKA6t84Ili","children":[],"key":"kvgrpPdUHE"}],"key":"NrqVvUSLUm"}],"key":"g2vwMork9h"},"references":{"cite":{"order":[],"data":{}}}}