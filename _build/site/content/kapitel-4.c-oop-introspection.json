    print(held.angreifen())\n    if hasattr(held, 'zaubern'):\n        print(held.zaubern())\n    if hasattr(held, 'heilen'):\n        print(held.heilen())","key":"TGnwDGZ9Rp"},{"type":"outputs","id":"e4sTkd0pmiuP4F3hFclV1","children":[],"key":"qEOBOKImaf"}],"key":"EzucMo270E"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# getattr() -- Attributwert dynamisch lesen\naldric = Krieger('Aldric')\n\n# Normal: aldric.name\n# Mit getattr: dynamisch, der Attributname kann eine Variable sein\nattribut = 'waffe'\nprint(getattr(aldric, attribut))            # Schwert\n\n# Fallback-Wert wenn Attribut nicht existiert\nprint(getattr(aldric, 'mana', 'kein Mana')) # kein Mana -- Fallback\n\n# setattr() -- Attribut dynamisch setzen\nsetattr(aldric, 'schild', 'Turmschild')\nprint(aldric.schild)                        # Turmschild\n\n# Praktisch: alle Attribute eines Helden auf einmal setzen\nausruestung = {'waffe': 'Axt', 'ruestung': 'Kettenhemd', 'helm': 'Eisenhelm'}\nfor attr, wert in ausruestung.items():\n    setattr(aldric, attr, wert)\n\nprint(aldric.waffe, aldric.ruestung, aldric.helm)","key":"yAEVK3jayf"},{"type":"outputs","id":"UNUbKTQjapg9J8k2eKyGP","children":[],"key":"FltZzH5eme"}],"key":"DB3ZWnjQmI"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"t