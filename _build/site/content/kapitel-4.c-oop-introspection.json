ground":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 4.4","key":"N7nrTkosf0"}],"key":"y4WDn5msMB"},{"type":"text","value":" 4. isinstance() und issubclass()","key":"DEhhqy3AZq"}],"key":"L9ej8gZjV5"}],"key":"Z9IDPXGkfX"}],"key":"yZL1TW5nKN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"type()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JA90o6W7Nj"},{"type":"text","value":" gibt die exakte Klasse eines Objekts zurueck. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rfn5BfOt2I"},{"type":"inlineCode","value":"isinstance()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PrlCMlGHID"},{"type":"text","value":" prueft dagegen die gesamte Vererbungskette -- es gibt ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B44V58OCFB"},{"type":"inlineCode","value":"True","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FxdlKfPoR7"},{"type":"text","value":" zurueck, wenn das Objekt eine Instanz der Klasse oder einer ihrer Unterklassen ist.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fUXA8oC22x"}],"key":"dmkHVhYRDU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Das ist besonders wichtig wenn man mit Vererbung arbeitet -- und ein zentrales Werkzeug fuer die PCAP-Pruefung.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PFRG8NJ1M7"}],"key":"k6lzU0BTJa"}],"key":"gjQKYPtUPt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Charakter:\n    pass\n\nclass Held(Charakter):\n    pass\n\nclass Krieger(Held):\n    pass\n\naldric = Krieger()\n\n# type() -- nur die direkte Klasse\nprint(type(aldric))              # <class '__main__.Krieger'>\nprint(type(aldric) == Krieger)   # True\nprint(type(aldric) == Held)      # False -- aldric ist Krieger, nicht Held\n\nprint()\n\n# isinstance() -- prueft die gesamte Vererbungskette\nprint(isinstance(aldric, Krieger))    # True  -- ist ein Krieger\nprint(isinstance(aldric, Held))       # True  -- Krieger erbt von Held\nprint(isinstance(aldric, Charakter))  # True  -- Held erbt von Charakter\nprint(isinstance(aldric, str))        # False -- keine Verwandtschaft","key":"wFpWbgN4bD"},{"type":"outputs","id":"yIU9WxtC6gs1ohE0aO-IG","children":[],"key":"WjzNM4WNRB"}],"key":"Gmsd9QbPSs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# issubclass() -- prueft Beziehung zwischen zwei Klassen (nicht Instanzen!)\nprint(issubclass(Krieger, Held))       # True\nprint(issubclass(Krieger, Charakter))  # True  -- auch ueber mehrere Ebenen\nprint(issubclass(Held, Krieger))       # False -- andersrum gilt nicht\nprint(issubclass(Krieger, Krieger))    # True  -- eine Klasse ist Unterklasse von sich selbst\n\n# Kombination: Alle Helden in einer gemischten Liste identifizieren\nclass Gegner:\n    pass\n\ntruppe = [Krieger(), Held(), Gegner(), Krieger()]\n\nhelden = [x for x in truppe if isinstance(x, Held)]\nprint(f'Helden in der Truppe: {len(helden)}')   # 3 -- Held und beide Krieger","key":"HhBcvh8YD5"},{"type":"outputs","id":"j-Pjn4h2pzMKZsbLHgX2l","children":[],"key":"GUUcLGC0tE"}],"key":"vKRF4V8r5k"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OS4ArqsF9H"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":