f, name):\n        self.name   = name\n        self.waffe  = 'Schwert'\n\n    def angreifen(self):\n        return f'{self.name} schlaegt mit {self.waffe} zu!'\n\nclass Magierin:\n    def __init__(self, name):\n        self.name   = name\n        self.mana   = 80\n\n    def zaubern(self):\n        return f'{self.name} wirkt einen Zauber!'\n\n    def heilen(self):\n        return f'{self.name} heilt einen Verbündeten!'\n\n\naldric = Krieger('Aldric')\nlyria  = Magierin('Lyria')\n\nhelden = [aldric, lyria]\n\n# Wir wollen zaubern() aufrufen -- aber nicht alle koennen das\nfor held in helden:\n    # Wie pruefen wir ob der Held zaubern() hat, ohne einen Fehler zu riskieren?\n    pass","key":"ARejr45Xjx"},{"type":"outputs","id":"cyw-zMYr4_SBPhiOktfRh","children":[],"key":"VEJFEsNrn2"}],"key":"YkwYrtIOW3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ohne Introspection muessten wir ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RZbRWtoKmK"},{"type":"inlineCode","value":"isinstance()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SnvvjzCWVN"},{"type":"text","value":" oder try/except verwenden. Mit ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V6qdhxn7g4"},{"type":"inlineCode","value":"hasattr()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n5Y73q9lTY"},{"type":"text","value":" geht es direkt und sauber.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BBTYqSKkWH"}],"key":"viq9rLcuvY"}],"key":"yXxnS9gGIC"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{