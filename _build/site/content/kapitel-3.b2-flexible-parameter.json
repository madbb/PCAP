):\n    def __init__(self, y, **kwargs):   # y nehmen, Rest weiterreichen\n        super().__init__(**kwargs)\n        self.y = y\n\nclass Kombination(Erweiterung, Basis):\n    def __init__(self, x, y):\n        super().__init__(x=x, y=y)    # alle als kwargs uebergeben\n\nobj = Kombination(x=10, y=20)\nprint(obj.x, obj.y)   # 10  20 -- beide Attribute gesetzt","key":"mtmHmE16qJ"},{"type":"outputs","id":"UHw5wBEZR43qf_KGEl4Om","children":[],"key":"yV4PS5gYPL"}],"key":"BT9lfegKZz"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"niEhcOwaAL"}],"key":"IjrGnY9yY1"},{"type":"text","value":" 6. Keyword-only Parameter","key":"OZmRBkvdKf"}],"key":"qi0IieOrdO"}],"key":"W30Eqoesa7"}],"key":"HYeYWz2gTH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Es gibt noch einen verwandten Mechanismus: Parameter die ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gzOue5FG2S"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"nur","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"STstEkqRhI"}],"key":"RQoz5AErTs"},{"type":"tex