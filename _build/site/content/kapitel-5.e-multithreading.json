"type":"text","value":" 2. Thread erstellen und starten","key":"pDjGIeZodo"}],"key":"JM41mJfziV"}],"key":"cHfpmmw0qf"}],"key":"Ooyb4NSSSl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import threading\nimport time\n\ndef lade_daten(quelle, dauer):\n    \"\"\"Simuliert das Laden von Daten aus einer externen Quelle.\"\"\"\n    print(f'Starte Laden von {quelle}...')\n    time.sleep(dauer)   # simuliert Netzwerklatenz\n    print(f'Fertig: {quelle} ({dauer}s)')\n\n# Sequenziell: 2 + 3 = 5 Sekunden\nprint('--- Sequenziell ---')\nstart = time.time()\nlade_daten('Datenbank', 1)\nlade_daten('API', 1)\nprint(f'Gesamt: {time.time() - start:.1f}s')\n\nprint()\n\n# Mit Threads: ca. max(2, 3) = 3 Sekunden\nprint('--- Mit Threads ---')\nstart = time.time()\n\nt1 = threading.Thread(target=lade_daten, args=('Datenbank', 1))\nt2 = threading.Thread(target=lade_daten, args=('API', 1))\n\nt1.start()\nt2.start()\n\nt1.join()   # Warten bis t1 fertig ist\nt2.join()   # Warten bis t2 fertig ist\n\nprint(f'Gesamt: {time.time() - start:.1f}s')","key":"ajVXKHT8Hl"},{"type":"outputs","id":"1GpCq2-3HH3iJOTZCxSaq","children":[],"key":"cxSbQnTD2x"}],"key":"zi4anvE3D7"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0d1f2d","borderLeft":"3px solid #1e4d6b","borderRadius":"3px","padding":"0.55em 1em","margin":"1.5rem 0 0.9rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(0.9rem,1.8vw,1.05rem)","fontWeight":"600","color":"#c5cae9","letterSpacing":"-0.005em"},"children":[{"type":"text","value":"Was passiert ohne join()?","key":"jeDEDxJqBu"}],"key":"uMxyem1nyd"}],"key":"qYTKro8uKI"}],"key":"BUX0rRjLvh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import threading, time\n\ndef aufgabe(name, dauer):\n    time.sleep(dauer)\n    print(f'{name} fertig')\n\nt = threading.Thread(target=aufgabe, args=('Hintergrund', 0.5))\nt.start()\n\n# Ohne join() laeuft der Hauptthread weiter\nprint('Hauptthread laeuft weiter...')\n\nt.join()  # erst hier wird gewartet\nprint('Nach join() -- Thread ist fertig')","key":"LIZT1sBrq1"},{"type":"outputs","id":"0r8rlvyAzGAX95KmjVtlb","children":[],"key":"nMzwapmz7G"}],"key":"PXpiM1uoE4"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"SIQFIyaxbQ"}],"key":"kXvpWmlBax"},{"type":"text","value":" 3. Thread als Klasse","key":"PICNjTtMOe"}],"key":"A8fpPKLIpU"}],"key":"yDzGCxmEXT"}],"key":"O8VIqGRV3b"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import threading\n\nclass BerechnungsThread(threading.Thread):\n    \"\"\"Thread der eine Berechnung durchfuehrt und das Ergebnis speichert.\"\"\"\n\n    def __init__(self, name, werte):\n        super().__init__()\n        self.name    = name\n        self.werte   = werte\n        self.summe   = None\n        self.maximum = None\n\n    def run(self):   # wird von start() aufgerufen -- hier nie direkt aufrufen!\n        self.summe   = sum(self.werte)\n        self.maximum = max(self.werte)\n        print(f'{self.name}: Summe={self.summe}, Max={self.maximum}')\n\n\n# Drei Threads parallel\nt1 = BerechnungsThread('Block-1', range(1,    1001))\nt2 = BerechnungsThread('Block-2', range(1001, 2001))\nt3 = BerechnungsThread('Block-3', range(2001, 3001))\n\nfor t in [t1, t2, t3]:\n    t.start()\n\nfor t in [t1, t2, t3]:\n    t.join()\n\nprint(f'Gesamtsumme: {t1.summe + t2.summe + t3.summe}')","key":"TnBGrZD3HZ"},{"type":"outputs","id":"S9Q8H9Frq4XRwQm0vTUlJ","children":[],"key":"ryDRUOaCNj"}],"key":"NndruO1i44"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"alNDHBwLAO"}],"key":"vMaFKezuYE"},{"type":"text","value":" 4. Race Conditions und Locks","key":"XM4mw1jIJR"}],"key":"quRZV0K3SI"}],"key":"hSQ5zrVlIN"}],"key":"MUUlzLKkGv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Eine ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nzvDKfv94J"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Race Condition","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N8NYGRazsS"}],"key":"RWPisZwbVf"},{"type":"text","value":" entsteht, wenn zwei Threads gleichzeitig eine geteilte Variable lesen und schreiben. Das Ergebnis haengt dann von der zuf