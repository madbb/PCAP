lobal zaehler\n    for _ in range(n):\n        with lock:       # acquire() -- nur ein Thread gleichzeitig\n            zaehler += 1\n        # release() automatisch am Ende des with-Blocks\n\nthreads = [threading.Thread(target=erhoehe_sicher, args=(10000,)) for _ in range(5)]\nfor t in threads: t.start()\nfor t in threads: t.join()\n\nprint(f'Mit Lock:   {zaehler} (erwartet 50000)')","key":"xLoB0CdXQ9"},{"type":"outputs","id":"vFAHzYBec8dCka0FlhjNI","children":[],"key":"ViPOU7gNTo"}],"key":"q1zddfkU0w"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"nwKCum0u7F"}],"key":"oIYMSbt5WL"},{"type":"text","value":" 5. Thread-Kommunikation mit Event","key":"zm89eWBI1x"}],"key":"GiiW7kSjPe"}],"key":"wDfDF0RrZV"}],"key":"kpOtqPPyMX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ein ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lTK911J2lm"},{"type":"inlineCode","value":"threading.Event","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lTqtulrdHR"},{"type":"text","value":" erlaubt es Threads, auf ein Signal zu warten. Ein Thread signalisiert mit ","position":{"start":{"line":1,"colu