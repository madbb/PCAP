ook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Was wenn wir die Zeitmessung auslagern -- in eine Funktion, die eine andere Funktion entgegennimmt, sie mit Zeitmessung umhuellt und die neue Version zurueckgibt?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nlrsDy5UDn"}],"key":"uz0JXQvmQr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Wir haben alle Werkzeuge dafuer bereits: hoeherwertige Funktionen (03b) und Closures (03c).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Atv1NhxB1F"}],"key":"YZd4EARzAe"}],"key":"ja6QW5vuLw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import time\n\n# Die Wrapper-Funktion nimmt eine Funktion entgegen\n# und gibt eine neue, erweiterte Version zurueck\ndef mit_zeitmessung(funktion):\n    def wrapper(*args, **kwargs):         # *args und **kwargs: alle Argumente weiterleiten\n        start = time.time()\n        ergebnis = funktion(*args, **kwargs)  # die Originalfunktion aufrufen\n        ende = time.time()\n        print(f'{funktion.__name__} lief {ende - start:.4f}s')\n        return ergebnis\n    return wrapper\n\n# Funktionen ohne Boilerplate\ndef berechne_summe(n):\n    return sum(range(n))\n\ndef berechne_produkt(zahlen):\n    ergebnis = 1\n    for z in zahlen:\n        ergebnis *= z\n    return ergebnis\n\n# Jetzt die Zeitmessung drum herumwickeln\nberechne_summe    = mit_zeitmessung(berechne_summe)\nberechne_produkt  = mit_zeitmessung(berechne_produkt)\n\nberechne_summe(1_000_000)\nberechne_produkt(range(1, 100))","key":"zOtIwvp39g"},{"type":"outputs","id":"V9R9lOPyobSlvrcfMZKYd","children":[],"key":"dWe9XxkmPZ"}],"key":"rQZSqRZvkc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":