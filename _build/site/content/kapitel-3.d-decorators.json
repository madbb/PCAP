ion.__name__} lief {ende - start:.4f}s')\n        return ergebnis\n    return wrapper\n\n# Mit @-Syntax: sauber und klar\n@mit_zeitmessung\ndef berechne_summe(n):\n    return sum(range(n))\n\n@mit_zeitmessung\ndef berechne_produkt(zahlen):\n    ergebnis = 1\n    for z in zahlen: ergebnis *= z\n    return ergebnis\n\nberechne_summe(1_000_000)\nberechne_produkt(range(1, 100))","key":"j8HeWFbGUz"},{"type":"outputs","id":"oBcope6bKmDEyPXBs5MFV","children":[],"key":"WHU9X65gHE"}],"key":"x1S8qKIqlR"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"yBgtBMeDV4"}],"key":"BSqsNnqgUu"},{"type":"text","value":" 4. Das Problem mit dem Namen -- functools.wraps","key":"gfvYGf0EK2"}],"key":"at7hVHIef3"}],"key":"fQUiJ4kXqZ"}],"key":"ymc46gHdBx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Es gibt ein subtiles Problem mit unserem Decorator. Nach dem Dekorieren zeigt ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X8TVZXAwDt"},{"type":"inlineCode","value":"berechne_summe","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JW6nOioqdK"},{"type":"text","value":" eigentlich auf ","position":{"star