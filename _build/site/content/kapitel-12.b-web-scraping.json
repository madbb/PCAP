","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\nfrom bs4 import BeautifulSoup\n\nresponse = requests.get('https://books.toscrape.com')\nsoup     = BeautifulSoup(response.text, 'html.parser')\n\n# Schritt 2: Struktur erkunden -- im Browser: Rechtsklick -> Untersuchen\n# Jedes Buch steckt in einem <article class=\"product_pod\">\nbuecher = soup.find_all('article', class_='product_pod')\nprint(f'{len(buecher)} Buecher auf der Seite')\n\n# Schritt 3: Daten extrahieren\nfor buch in buecher[:5]:   # erste 5\n    titel = buch.find('h3').find('a')['title']   # title-Attribut hat vollen Namen\n    preis = buch.find('p', class_='price_color').text\n    print(f'{titel[:40]:40} {preis}')","key":"oHHGDFrS6i"},{"type":"outputs","id":"VAW9_gnOIp9-HgFsNe8pB","children":[],"key":"iKSR0ZR0Ae"}],"key":"g0rEk8nSy4"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"E2AIB8SbP1"}],"key":"Q5MQIe6EtY"},{"type":"text","value":" 7. Mehrere Seiten scrapen -- Paginierung","key":"uwcMkdtWvp"}],"key":"aZK2HBTwiv"}],"key":"JNjPbvT8jj"}],"key":"DAFuph545I"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Die meisten Websites zeigen Daten auf mehreren Seiten. Um alle Daten zu bekommen, muss man automatisch durch die Seiten navigieren -- Paginierung.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WbTgv71HVw"}],"key":"P3zfh2R4rY"}],"key":"oYlCplZJg4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\nfrom bs4 import BeautifulSoup\n\nBASE_URL = 'https://books.toscrape.com/catalogue'\nalle_buecher = []\nseite = 1\nmax_seiten = 3   # nur 3 Seiten fuer die Demo\n\nwhile seite <= max_seiten:\n    url = f'{BASE_URL}/page-{seite}.html'\n    response = requests.get(url)\n\n    if response.status_code != 200:\n        print(f'Seite {seite} nicht erreichbar -- stoppe')\n        break\n\n    soup    = BeautifulSoup(response.text, 'html.parser')\n    buecher = soup.find_all('article', class_='product_pod')\n\n    for buch in buecher:\n        titel = buch.find('h3').find('a')['title']\n        preis = buch.find('p', class_='price_color').text.strip()\n        # Sternebewertung aus class-Name extrahieren (One, Two, Three...)\n        bewertung = buch.find('p', class_='star-rating')['class'][1]\n        alle_buecher.append({'titel': titel, 'preis': preis, 'bewertung': bewertung})\n\n    print(f'Seite {seite}: {len(buecher)} Buecher geladen')\n    seite += 1\n\nprint(f'\\nGesamt: {len(alle_buecher)} Buecher')\nprint('\\nBeispiel:')\nfor b in alle_buecher[:3]:\n    print(f'  {b[\"titel\"][:40]:40} {b[\"preis\"]:8}  Sterne: {b[\"bewertung\"]}')","key":"tcSjSJm1HE"},{"type":"outputs","id":"TwIxfjODs4jtP3sUO7ft_","children":[],"key":"BI50mmiMe6"}],"key":"FFuRJvugy0"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fo