-- self.args bestimmt print(e)\nclass MeinFehler(Exception):\n    def __init__(self, msg):\n        Exception.__init__(self, msg + msg)  # args = (msg+msg,)\n        self.args = (msg,)                   # args = (msg,) -- ueberschrieben!\n\ntry:\n    raise MeinFehler('hallo')\nexcept MeinFehler as e:\n    print(e)        # 'hallo' -- nicht 'hallohallo'!\n    print(e.args)   # ('hallo',)","key":"jG66eFR2FK"},{"type":"outputs","id":"Kx6dI1qHEpPCqXNgPkOXk","children":[],"key":"HZzCNM6dKV"}],"key":"fktjdkOjrU"}],"key":"oo98W2CrYq"},"references":{"cite":{"order":[],"data":{}}}}