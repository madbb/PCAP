per().__new__(cls)\n            cls._instanz.name = 'Aetherion'\n            cls._instanz.stufe = 1\n        return cls._instanz\n\nwelt1 = Spielwelt()\nwelt2 = Spielwelt()\n\nprint(welt1 is welt2)    # True -- immer dieselbe Instanz\nprint(welt1.name)        # Aetherion\n\nwelt1.stufe = 5\nprint(welt2.stufe)       # 5 -- dieselbe Instanz, dieselbe Aenderung","key":"reLJSfRo5j"},{"type":"outputs","id":"Fqy8KSV-1B8Y_9DiqkoMY","children":[],"key":"tYvg8ww2Q3"}],"key":"Gxnwtx9SIf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# FACTORY -- Objekterstellung kapseln\n# Anwendungsfall: Held basierend auf Klassennamen erstellen\n\nclass Held:\n    def __init__(self, name, hp, staerke):\n        self.name    = name\n        self.hp      = hp\n        self.staerke = staerke\n    def __str__(self):\n        return f'{self.name} ({self.__class__.__name__}) HP:{self.hp} STR:{self.staerke}'\n\nclass Krieger(Held):\n    def __init__(self, name): super().__init__(name, 120, 18)\n\nclass Magier(Held):\n    def __init__(self, name): super().__init__(name, 70, 8)\n\nclass Waldlaeufer(Held):\n    def __init__(self, name): super().__init__(name, 90, 14)\n\n\ndef erstelle_held(klasse: str, name: str) -> Held:\n    \"\"\"Factory: erstellt den richtigen Helden basierend auf dem Klassennamen.\"\"\"\n    klassen = {\n        'krieger':     Krieger,\n        'magier':      Magier,\n        'waldlaeufer': Waldlaeufer,\n    }\n    if klasse.lower() not in klassen:\n        raise ValueError(f'Unbekannte Klasse: {klasse}')\n    return klassen[klasse.lower()](name)\n\n\n# Helden per Name erstellen -- die Logik steckt in der Factory\nparty = [\n    erstelle_held('krieger',     'Aldric'),\n    erstelle_held('magier',      'Lyria'),\n    erstelle_held('waldlaeufer', 'Thorn'),\n]\n\nfor held in party:\n    print(held)","key":"yyidPmR22Z"},{"type":"outputs","id":"8rF8svCDnk-DSZsn-BSJt","children":[],"key":"nAmE4JiCui"}],"key":"S2CFh9Dkz6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# OBSERVER -- Ereignisse verteilen\n# Anwendungsfall: Wenn ein Held stirbt, sollen mehrere Systeme reagieren\n\nclass Ereignissystem:\n    def __init__(self):\n        self._handler = {}   # Ereignisname -> Liste von Funktionen\n\n    def anmelden(self, ereignis, funktion):\n        self._handler.setdefault(ereignis, []).append(funktion)\n\n    def ausloesen(self, ereignis, **daten):\n        for fn in self._handler.get(ereignis, []):\n            fn(**daten)\n\n\nereignisse = Ereignissystem()\n\n# Verschiedene Systeme reagieren auf dasselbe Ereignis\nereignisse.anmelden('held_gestorben',\n    lambda name, **_: print(f'LOG: {name} ist gestorben'))\nereignisse.anmelden('held_gestorben',\n    lambda name, **_: print(f'UI: Zeige Game-Over fuer {name}'))\nereignisse.anmelden('held_gestorben',\n    lambda name, **_: print(f'AUDIO: Spiele Sterbesequenz'))\n\n# Ereignis ausloesen -- alle Handler werden benachrichtigt\nereignisse.ausloesen('held_gestorben', name='Aldric')","key":"zeLpmBjchP"},{"type":"outputs","id":"Rqhfm6jSu7rZBvc-emOh_","children":[],"key":"GidIrQyhqs"}],"key":"p4vEWRHEAS"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VagXxQd7Kn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Zusammenfassung","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rrq8zOs5zf"}],"key":"olmTloHPIL"}],"key":"QyTty7leHM"},{"type":"table","position":{"start":{"line":5,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"tableCell","header":true,"posit