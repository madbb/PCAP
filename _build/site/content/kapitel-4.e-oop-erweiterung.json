   if not self._items:\n            return 'Inventar: (leer)'\n        return 'Inventar: ' + ', '.join(self._items)\n\n\nrucksack = Inventar(['Schwert', 'Schild', 'Heiltrank'])\ntruhe    = Inventar(['Goldmuenzen', 'Schluessel'])\n\nprint(len(rucksack))              # __len__: 3\nprint('Schwert' in rucksack)      # __contains__: True\nprint('Zauberstab' in rucksack)   # __contains__: False\n\nalles = rucksack + truhe          # __add__\nprint(alles)                      # __str__\n\nprint('Alle Gegenstaende:')\nfor item in rucksack:             # __iter__\n    print(f'  - {item}')","key":"PwtMv9oBcg"},{"type":"outputs","id":"UxQX6lh_i3w3db17-SPot","children":[],"key":"wjU7MAgNTP"}],"key":"okBe9Xr2bB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Uebersicht wichtiger Dunder-Methoden:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IzpFDzIeDm"}],"key":"A7ZbYkHAS6"}],"key":"On3R0F9o0m"},{"type":"table","position":{"start":{"line":3,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Methode","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"B3mk2lAkVH"}],"key":"cdIQ6KUaOv"},{"type":"tableCell","header":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Wird aufgerufen bei","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fwDFtvWI2F"}],"key":"HrvKoADtME"}],"key":"s0glGL9QWC"},{"type":"tableRow","position":{"start":{"line":5,"column":1},"end":{"line":5,"