d2ya"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Waffe:\n    def __init__(self, name, schaden, typ):\n        self.name   = name\n        self.schaden = schaden\n        self.typ    = typ\n\n    def __str__(self):\n        return f'{self.name} ({self.typ}, {self.schaden} Schaden)'\n\n\nclass Ruestung:\n    def __init__(self, name, schutz):\n        self.name   = name\n        self.schutz = schutz\n\n    def __str__(self):\n        return f'{self.name} ({self.schutz} Schutz)'\n\n\nclass Held:\n    def __init__(self, name, hp):\n        self.name    = name\n        self.hp      = hp\n        self.waffe   = None   # Komposition: Waffe ist ein Attribut\n        self.ruestung = None\n\n    def ausruesten(self, gegenstand):\n        if isinstance(gegenstand, Waffe):\n            self.waffe = gegenstand\n            print(f'{self.name} traegt jetzt {gegenstand.name}')\n        elif isinstance(gegenstand, Ruestung):\n            self.ruestung = gegenstand\n            print(f'{self.name} traegt jetzt {gegenstand.name}')\n\n    def angreifen(self):\n        if self.waffe:\n            return self.waffe.schaden\n        return 5  # Faustkampf\n\n    def __str__(self):\n        w = str(self.waffe) if self.waffe else 'keine'\n        r = str(self.ruestung) if self.ruestung else 'keine'\n        return f'{self.name} | HP: {self.hp} | Waffe: {w} | Ruestung: {r}'\n\n\naldric = Held('Aldric', 100)\nprint(aldric)\n\nschwert    = Waffe('Eisenschwert', 25, 'Nahkampf')\nkettenhemd = Ruestung('Kettenhemd', 10)\n\naldric.ausruesten(schwert)\naldric.ausruesten(kettenhemd)\nprint(aldric)\nprint(f'Angriff: {aldric.angreifen()} Schaden')","key":"ndrCLCRliR"},{"type":"outputs","id":"-Dw7ZE78g-IE5xLsR_lVy","children":[],"key":"S0kQfLNa7R"}],"key":"lSNJvQHi4V"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type"