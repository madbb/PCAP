* 9/5 + 32\n\nprint(verarbeite_liste(temperaturen_celsius, celsius_zu_fahrenheit))\n# [32.0, 68.0, 98.6, 212.0]\n\n# Dieselbe Funktion, andere Transformation\nprint(verarbeite_liste(temperaturen_celsius, lambda c: round(c * 9/5 + 32, 1)))\nprint(verarbeite_liste(temperaturen_celsius, str))","key":"W0QWES8vZm"},{"type":"outputs","id":"JbLczhWU63ELhkc86Q-c-","children":[],"key":"RR82JpGvnR"}],"key":"U4tIgr0IIx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Noch ein Beispiel: Funktion die filtert und transformiert\ndef filtere_und_wandle(daten, bedingung, transformation):\n    \"\"\"\n    Behaelt nur Elemente die die Bedingung erfuellen\n    und wendet dann die Transformation an.\n    \"\"\"\n    return [transformation(x) for x in daten if bedingung(x)]\n\nzahlen = [-4, -2, 0, 1, 3, 5, 8]\n\n# Nur positive Zahlen, quadriert\nergebnis = filtere_und_wandle(\n    zahlen,\n    bedingung=lambda x: x > 0,\n    transformation=lambda x: x ** 2\n)\nprint(ergebnis)  # [1, 9, 25, 64]\n\n# Nur gerade Zahlen, als String\nergebnis2 = filtere_und_wandle(\n    zahlen,\n    bedingung=lambda x: x % 2 == 0,\n    transformation=str\n)\nprint(ergebnis2)  # ['-4', '-2', '0', '8']","key":"xweByamnLE"},{"type":"outputs","id":"9bFj3AinprvRy_B0e-VIC","children":[],"key":"m7e8fWDVm9"}],"key":"SdYZioabCh"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","m