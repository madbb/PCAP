-code","children":[{"type":"code","lang":"python","executable":true,"value":"def erstelle_bereichspruefer(minimum, maximum):\n    \"\"\"\n    Gibt eine Funktion zurueck, die prueft ob ein Wert\n    zwischen minimum und maximum liegt.\n    \"\"\"\n    def pruefer(wert):\n        return minimum <= wert <= maximum\n    return pruefer\n\n# Drei verschiedene Pruefer erstellen\nist_schulnote    = erstelle_bereichspruefer(1, 6)\nist_prozentwert  = erstelle_bereichspruefer(0, 100)\nist_temperatur   = erstelle_bereichspruefer(-273, 1000)\n\n# Jeder Pruefer ist eine eigene Funktion\nprint(ist_schulnote(3))      # True\nprint(ist_schulnote(0))      # False\nprint(ist_prozentwert(75))   # True\nprint(ist_prozentwert(150))  # False\n\n# Nuetzlich: Validierung in einem Schritt\neingaben = [1, 3, 7, 2, 9, 4]\ngueltige_noten = [n for n in eingaben if ist_schulnote(n)]\nprint(gueltige_noten)  # [1, 3, 2, 4]","key":"AkFTfzLQn2"},{"type":"outputs","id":"oa_633DomoNGIAJtcBDxN","children":[],"key":"JliOQhDKvo"}],"key":"LeC2HfiiPf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Was passiert hier technisch? ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B95Viaizbo"},{"type":"inlineCode","value":"erstelle_bereichspruefer(1, 6)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s2goRpoE8d"},{"type":"text","value":" ruft die aeussere Funktion auf -- ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CCvFCmAax3"},{"type":"inlineCode","value":"minimum","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N6A3FGBBBl"},{"type":"text","value":" und ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x87QzrDjdG"},{"type":"inlineCode","value":"maximum","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"ke