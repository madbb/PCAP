e":"text","value":"Der Badge im README wird rot","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"VFqlBQpHPS"}],"key":"aytBx8P4Jn"}],"key":"K1xE5Phle7"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Wer den Pull Request gestellt hat, bekommt eine E-Mail","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MBMPwUhJ3Y"}],"key":"DLzhBQZpzu"}],"key":"FMCMddObAh"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Der Merge in ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"nYWXXJF3WN"},{"type":"inlineCode","value":"main","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"D1wic8LiLV"},{"type":"text","value":" kann blockiert werden -- bis alle Tests bestehen","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JbtyHEWVQs"}],"key":"BJEDKRnPFM"}],"key":"IDFvCBPYgX"}],"key":"mxX7GchAPc"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Das ist der entscheidende Unterschied zu lokalem Testen: Kein Code der Tests bricht kommt in den Hauptbranch -- unabhaengig davon ob jemand vergessen hat zu testen.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"jbQ5ol0hP4"}],"key":"OBu9juATm1"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Schauen wir uns an wie man einen fehlerhaften Commit simuliert und was passiert:","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"dIBawAWHJo"}],"key":"Qtxn61jE5s"}],"key":"dCs6pcjf4k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Simulation: jemand aendert combat.py und bricht einen Test\ncombat_kaputt = '''\ndef berechne_schaden(angriff, verteidigung):\n    if angriff < 0 or verteidigung < 0:\n        raise ValueError(\"Angriff und Verteidigung muessen >= 0 sein\")\n    schaden = angriff - verteidigung\n    return max(0, schaden)   # Bug wieder eingebaut: max(0, ...) statt max(1, ...)\n\ndef trefferchance(angreifer_geschwindigkeit, ziel_geschwindigkeit):\n    if angreifer_geschwindigkeit <= 0 or ziel_geschwindigkeit <= 0:\n        raise ValueError(\"Geschwindigkeit muss > 0 sein\")\n    chance = 50 + (angreifer_geschwindigkeit - ziel_geschwindigkeit) * 5\n    return max(10, min(95, chance))\n\ndef kritischer_treffer(schaden, krit_faktor=1.5):\n    if krit_faktor < 1.0:\n        raise ValueError(\"krit_faktor muss >= 1.0 sein\")\n    if schaden < 0:\n        raise ValueError(\"Schaden muss >= 0 sein\")\n    return int(schaden * krit_faktor)\n\ndef heilen(aktuelle_hp, max_hp, heilmenge):\n    if max_hp <= 0:\n        raise ValueError(\"max_hp muss > 0 sein\")\n    if heilmenge <= 0:\n        raise ValueError(\"heilmenge muss > 0 sein\")\n    if aktuelle_hp <= 0:\n        return aktuelle_hp\n    return min(max_hp, aktuelle_hp + heilmenge)\n\ndef ist_besiegt(hp):\n    return hp <= 0\n\ndef statuseffekt_anwenden(schaden, effekt):\n    if schaden < 0:\n        raise ValueError(\"Schaden muss >= 0 sein\")\n    faktoren = {\n        \"normal\": 1.0, \"vergiftet\": 1.5,\n        \"geschwaeht\": 0.75, \"verstaerkt\": 2.0,\n    }\n    if effekt not in faktoren:\n        raise ValueError(f\"Unbekannter Statuseffekt: {effekt!r}\")\n    return int(schaden * faktoren[effekt])\n'''\n\nwith open('../combat/combat.py', 'w') as f:\n    f.write(combat_kaputt)\n\nprint('combat.py mit Bug gespeichert -- was sagt die Pipeline?')","key":"qBB3nBEwix"},{"type":"outputs","id":"Qz9vNPEVe6kUXv7hzY-FK","children":[],"key":"OM97G8LxVf"}],"key":"zs5I1T7ujr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import subprocess\n\n# Lokal testen -- genau das wuerde die Pipeline auf GitHub machen\nresult = subprocess.run(\n    ['python', '-m', 'pytest', 'test_combat.py', '-v', '--tb=short'],\n    capture_output=True, text=True\n)\nprint(result.stdout[-3000:])  # letzte 3000 Zeichen -- relevante Fehler","key":"gFD68f4niH"},{"type":"outputs","id":"QRGuHfvBvNMzNMvRYRdRa","children":[],"key":"RhLdadm96Y"}],"key":"oLeFGIsabq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Genau diese Ausgabe wuerde die GitHub Actions Pipeline produzieren -- und den Commit als fehlerhaft markieren. Niemand muss manuell pruefen. Die Pipeline macht es automatisch.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aeHU2FezdP"}],"key":"pnciVnGnsT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Jetzt stellen wir ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VlzLcxZIJP"},{"type":"inlineCode","value":"combat.py","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p6Y4IzZl62"},{"type":"text","value":" wieder her:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yET7BrX4da"}],"key":"Lx7xMnUur0"}],"key":"LMcrdAhs8K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"combat_korrekt = '''\n\"\"\"combat.py -- Kampfsystem Aetherion, Version 2 (alle Bugs behoben)\"\"\"\n\n\ndef berechne_schaden(angriff, verteidigung):\n    if angriff < 0 or verteidigung < 0:\n        raise ValueError(\"Angriff und Verteidigung muessen >= 0 sein\")\n    return max(1, angriff - verteidigung)\n\n\ndef trefferchance(angreifer_geschwindigkeit, ziel_geschwindigkeit):\n    if angreifer_geschwindigkeit <= 0 or ziel_geschwindigkeit <= 0:\n        raise ValueError(\"Geschwindigkeit muss > 0 sein\")\n    chance = 50 + (angreifer_geschwindigkeit - ziel_geschwindigkeit) * 5\n    return max(10, min(95, chance))\n\n\ndef kritischer_treffer(schaden, krit_faktor=1.5):\n    if krit_faktor < 1.0:\n        raise ValueError(\"krit_faktor muss >= 1.0 sein\")\n    if schaden < 0:\n        raise ValueError(\"Schaden muss >= 0 sein\")\n    return int(schaden * krit_faktor)\n\n\ndef heilen(aktuelle_hp, max_hp, heilmenge):\n    if max_hp <= 0:\n        raise ValueError(\"max_hp muss > 0 sein\")\n    if heilmenge <= 0:\n        raise ValueError(\"heilmenge muss > 0 sein\")\n    if aktuelle_hp <= 0:\n        return aktuelle_hp\n    return min(max_hp, aktuelle_hp + heilmenge)\n\n\ndef ist_besiegt(hp):\n    return hp <= 0\n\n\ndef statuseffekt_anwenden(schaden, effekt):\n    if schaden < 0:\n        raise ValueError(\"Schaden muss >= 0 sein\")\n    faktoren = {\n        \"normal\": 1.0, \"vergiftet\": 1.5,\n        \"geschwaeht\": 0.75, \"verstaerkt\": 2.0,\n    }\n    if effekt not in faktoren:\n        raise ValueError(f\"Unbekannter Statuseffekt: {effekt!r}\")\n    return int(schaden * faktoren[effekt])\n'''\n\nwith open('../combat/combat.py', 'w') as f:\n    f.write(combat_korrekt)\n\n# Alle Tests laufen -- alles gruen\nresult = subprocess.run(\n    ['python', '-m', 'pytest', 'test_combat.py', '-v'],\n    capture_output=True, text=True\n)\n# Nur die Zusammenfassung zeigen\nfor zeile in result.stdout.split('\\n'):\n    if 'passed' in zeile or 'failed' in zeile or 'error' in zeile:\n        print(zeile)","key":"qHunUT2Bti"},{"type":"outputs","id":"0ZQNx535vJ8f4fU8Amaxr","children":[],"key":"zA02eVgQzH"}],"key":"uFZWpYzD2l"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe 