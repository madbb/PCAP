":1,"column":1}},"key":"bZjmDgYGys"}],"key":"EvwiBVEHjN"},{"type":"code","lang":"","value":".github/\n    workflows/\n        tests.yml     <-- hier liegt unsere Pipeline","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"key":"DLWo7aRzFj"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Schauen wir uns die minimale Pipeline Zeile fuer Zeile an:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"oQSKQAfliw"}],"key":"gIWNpnhe3C"}],"key":"c6s39jXfkY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pipeline_erklaert = \"\"\"\n# Name des Workflows -- erscheint in GitHub unter \"Actions\"\nname: Tests\n\n# Wann soll der Workflow ausgefuehrt werden?\non:\n  push:                    # Bei jedem Push...\n    branches: [ main ]     # ...auf den main-Branch\n  pull_request:            # Und bei jedem Pull Request\n    branches: [ main ]\n\n# Was soll ausgefuehrt werden?\njobs:\n  test:                              # Name des Jobs\n    runs-on: ubuntu-latest           # Betriebssystem: aktuelles Ubuntu\n\n    steps:                           # Einzelne Schritte in Reihenfolge\n\n      - name: Code auschecken        # Schritt 1: Repository herunterladen\n        uses: actions/checkout@v4    # vorgefertigte Action von GitHub\n\n      - name: Python einrichten      # Schritt 2: Python installieren\n        uses: actions/setup-python@v5\n        with:\n          python-version: '3.11'\n\n      - name: Abhaengigkeiten        # Schritt 3: Pakete installieren\n        run: pip install pytest\n\n      - name: Tests ausfuehren       # Schritt 4: pytest starten\n        run: pytest -v\n\"\"\"\n\nprint(pipeline_erklaert)","key":"S62OGPJe5T"},{"type":"outputs","id":"P410EbKrS-tJ08Jm4fsNZ","children":[],"key":"CpkJVZs4KX"}],"key":"wOLYT1vzGt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\n\n# Verzeichnisstruktur anlegen\nos.makedirs('.github/workflows', exist_ok=True)\n\n# Die minimale Pipeline\npipeline_minimal = \"\"\"name: Tests\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  test:\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Code auschecken\n        uses: actions/checkout@v4\n\n      - name: Python einrichten\n        uses: actions/setup-python@v5\n        with:\n          python-version: '3.11'\n\n      - name: Abhaengigkeiten installieren\n        run: pip install pytest\n\n      - name: Tests ausfuehren\n        run: pytest -v\n\"\"\"\n\nwith open('.github/workflows/tests.yml', 'w') as f:\n    f.write(pipeline_minimal)\n\nprint('Datei erstellt: .github/workflows/tests.yml')\nprint()\nprint('Naechste Schritte:')\nprint('  git add .github/workflows/tests.yml')\nprint('  git commit -m \"CI: Tests mit GitHub Actions\"')\nprint('  git push')\nprint()\nprint('Danach: GitHub -> Repository -> Actions -> Tests')","key":"R45ElIQhzn"},{"type":"outputs","id":"LgplWLCfZdK6ngpwWTGNm","children":[],"key":"gks6nULtOh"}],"key":"Oww0gFdmXd"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"xOl4hCgKdi"}],"key":"BtdMaTDkM7"},{"type":"text","value":" 5. Erweiterte Pipeline -- mit Coverage und mehreren Python-Versionen","key":"h1lCCdVJTD"}],"key":"LHucsjAD9L"}],"key":"cDvdjDDl4A"}],"key":"UxPrtjJM4u"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Die minimale Pipeline ist gut fuer den Einstieg. In der Praxis will man mehr: Coverage messen, auf mehreren Python-Versionen testen, einen Coverage-Report als Artefakt speichern.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p4aLeXdPIO"}],"key":"mVeIt96CVF"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"GitHub Actions unterstuetzt ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wQ2cP5vSmu"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Matrix-Builds","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mL1UH3BqKp"}],"key":"YS9lCS2nLB"},{"type":"text","value":" -- denselben Job gleichzeitig mit verschiedenen Konfigurationen ausfuehren:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AEtdjAUwuu"}],"key":"hP2WA2V95O"}],"key":"RclWnUY53w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pipeline_erweitert = \"\"\"name: Tests\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  test:\n    runs-on: ubuntu-latest\n\n    # Matrix: testet auf mehreren Python-Versionen gleichzeitig\n    strategy:\n      matrix:\n        python-version: ['3.10', '3.11', '3.12']\n\n    steps:\n      - name: Code auschecken\n        uses: actions/checkout@v4\n\n      - name: Python ${{ matrix.python-version }} einrichten\n        uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python-version }}\n\n      - name: Abhaengigkeiten installieren\n        run: pip install pytest pytest-cov\n\n      - name: Tests mit Coverage\n        run: pytest -v --cov=combat --cov=held --cov-report=xml\n\n      - name: Coverage-Report speichern\n        uses: actions/upload-artifact@v4\n        with:\n          name: coverage-py${{ matrix.python-version }}\n          path: coverage.xml\n\"\"\"\n\nwith open('.github/workflows/tests_erweitert.yml', 'w') as f:\n    f.write(pipeline_erweitert)\n\nprint('Erweiterte Pipeline erstellt: .github/workflows/tests_erweitert.yml')","key":"klvVI2KRkR"},{"type":"outputs","id":"s5wTrT5EdLRYyhFTRVeSi","children":[],"key":"E2TWnAvwSk"}],"key":"u3C3wrwPRM"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"CKXXJbzPPH"}],"key":"oCrwd61Ayl"},{"type":"text","value":" 6. Status-Badge im README","key":"XuqRP87dEB"}],"key":"YVS0zRizQL"}],"key":"iGbXlSDdne"}],"key":"ZnGKZg9Z0p"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ein ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KD2l10klad"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"l