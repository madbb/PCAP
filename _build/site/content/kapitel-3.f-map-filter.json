   filter(lambda x: x % 2 == 0, zahlen)))\n\n# Variante 2: List Comprehension\nergebnis2 = [x**2 for x in zahlen if x % 2 == 0]\n\nprint(ergebnis1)  # [4, 16, 36, 64, 100]\nprint(ergebnis2)  # [4, 16, 36, 64, 100]\nprint(ergebnis1 == ergebnis2)  # True -- identisches Ergebnis\n\n# Variante 3: map() mit benannter Funktion -- gut lesbar\nimport math\nwurzeln = list(map(math.sqrt, zahlen))   # kein Lambda noetig\nprint(wurzeln)","key":"ExZtsKSVz6"},{"type":"outputs","id":"FW1uio87vh2Ixar8ejWQY","children":[],"key":"LD3jwxlwiW"}],"key":"zlGLuyVdyP"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"PCAP 5.2","key":"ovagPpwJXq"}],"key":"q4gEEFckFl"},{"type":"text","value":" 5. Eigene Funktionen die Lambdas entgegennehmen","key":"pUrMy7Pd94"}],"key":"r8GnoO9KhS"}],"key":"vpjzz9h8bP"}],"key":"hLIZ5fuhpq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Der PCAP-Syllabus nennt explizit ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ItV8cI2n83"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"“self-defined functions taking lambdas as arguments”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GkgoUu5SPw"}],"key":"FgYF10iCQX"},{"type":"text","value":". Das bedeutet: eigene Funktionen schreiben, die eine Funktion (z.B. ein Lambda) als Parameter erwarten und intern aufrufen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RSL6Jgnybb"}],"key":"UzcsL2ZEs9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Das kennen wir bereits aus 03b -- hier nochmal konkret mit Lambda kombiniert:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JEd1A4VGlI"}],"key":"etfZnfT1w3"}],"key":"qTlpxFy7MH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def wende_auf_alle_an(werte, transformation):\n    \"\"\"Wendet eine Transformationsfunktion auf jedes Element an.\"\"\"\n    return [transformation(x) for x in werte]\n\nzahlen = [1, 2, 3, 4, 5]\n\n# Mit Lambda aufrufen\nprint(wende_auf_alle_an(zahlen, lambda x: x ** 2))\nprint(wende_auf_alle_an(zahlen, lambda x: x * 3))\n\n# Mit normaler Funktion aufrufen -- Lambda ist nicht Pflicht\nprint(wende_auf_alle_an(zahlen, str))\nprint(wende_auf_alle_an(zahlen, math.sqrt))\n\n# Mit mehreren Parametern\ndef wende_mit_bedingung_an(werte, bedingung, transformation):\n    return [transformation(x) for x in werte if bedingung(x)]\n\nergebnis = wende_mit_bedingung_an(\n    zahlen,\n    bedingung=lambda x: x % 2 == 0,    # nur gerade\n    transformation=lambda x: x ** 2     # dann quadrieren\n)\nprint(ergebnis)  # [4, 16]","key":"wsz0ESQub3"},{"type":"outputs","id":"z__x1i2gHg8rFe0exxEGU","children":[],"key":"dNaLkDu4IE"}],"key":"aaiwLXcp3q"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JNuXN9Px3f"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":