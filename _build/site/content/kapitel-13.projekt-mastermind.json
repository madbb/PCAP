","position":{"start":{"line":4,"column":1},"end":{"line":8,"column":1}},"key":"NSQXPpBBfo"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Erst wenn diese Funktion korrekt ist, weitermachen.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"MEoSBjCCUk"}],"key":"EaBPlmEuHx"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Schritt 2 -- Das Grundspiel in der Konsole:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"PNlcO2ltXb"}],"key":"kyGB92A6Sz"},{"type":"text","value":"\nZufaelligen Code erzeugen, Eingabe einlesen, bewerten, ausgeben. Eine einfache Schleife, kein OOP noetig.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"n3Yss0uo6Y"}],"key":"pd7GINusHn"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Schritt 3 -- Struktur einfuehren:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"EflfrdGOA9"}],"key":"KcS0IMCIEq"},{"type":"text","value":"\nWenn das Grundspiel laeuft, ueberlege ob sich eine Klasse lohnt. Vielleicht eine ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"zXb7w2bRve"},{"type":"inlineCode","value":"Spiel","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Odf99EYazV"},{"type":"text","value":"-Klasse die den Zustand haelt und Methoden wie ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"TmKxLawV6k"},{"type":"inlineCode","value":"versuch_ausfuehren()","position":{"start":{"line":15,"column":1},"