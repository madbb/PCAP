"type":"text","value":" 1. Das naechste Problem: Wiederholung in Tests","key":"UATx5VS1fc"}],"key":"L13wCm2BxP"}],"key":"Yhw3fLh0Ty"}],"key":"mDOpsfgDTW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In 10b haben wir 30 Tests geschrieben. Das funktioniert gut -- aber schau dir die Tests fuer ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dZxmxGCJar"},{"type":"inlineCode","value":"heilen()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LOKDOVdRKA"},{"type":"text","value":" an: Jeder Test erstellt dieselben Grundannahmen neu. Und wenn wir anfangen, komplexere Objekte zu testen -- zum Beispiel einen ganzen ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hnhJtZUi45"},{"type":"inlineCode","value":"Held","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QrTtDSSiK0"},{"type":"text","value":" mit Name, HP, Angriff und Level -- dann wuerde jeder Test dieses Objekt neu aufbauen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oCRQ7lMmyy"}],"key":"nlQVhwUOzI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Schauen wir uns an wie das aussieht wenn man es nicht loest:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HX58OrE3Ni"}],"key":"pyNlXk0lQJ"}],"key":"H2iE6bBxry"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Stell dir vor, wir testen eine Held-Klasse\n# Ohne Fixtures sieht jeder Test so aus:\n\nbeispiel_ohne_fixture = '''\ndef test_held_erhaelt_schaden():\n    held = Held(name=\"Aldric\", hp=100, max_hp=100, angriff=15, verteidigung=5)\n    held.erleidet_schaden(20)\n    assert held.hp == 80\n\ndef test_held_wird_geheilt():\n    held = Held(name=\"Aldric\", hp=100, max_hp=100, angriff=15, verteidigung=5)\n    held.erleidet_schaden(50)\n    held.heilen(20)\n    assert held.hp == 70\n\ndef test_held_ist_besiegt():\n    held = Held(name=\"Aldric\", hp=100, max_hp=100, angriff=15, verteidigung=5)\n    held.erleidet_schaden(100)\n    assert held.ist_besiegt() == True\n\n# ... 20 weitere Tests, alle beginnen mit denselben 5 Zeilen\n'''\nprint('Problem: Jeder Test baut denselben Held neu auf.')\nprint('Wenn sich die Held-Klasse aendert, muss man 20 Tests anpassen.')","key":"dRdaR5Orpl"},{"type":"outputs","id":"sT9xuFJrGyEg1eFytSwB9","children":[],"key":"EX0UhO4pAN"}],"key":"B6MDSPNKDG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Das verletzt das DRY-Prinzip (Don’t Repeat Yourself) -- und macht Tests schwer zu warten. pytest loest das mit ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HGbyaExoMW"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Fixtures","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nVSsvE4CXf"}],"key":"mBpgoUy4DQ"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RSWvQetdZX"}],"key":"UgRGlURvWe"}],"key":"MGSXyo7wPK"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"B0Kc44Qc8X"}],"key":"m8GUmugUoI"},{"type":"text","value":" 2. Fixtures -- Testdaten einmal definieren, ueberall verwenden","key":"XUbkqCwcRQ"}],"key":"HvhPNWbe6s"}],"key":"ytRiHhBNZs"}],"key":"H9JC6elpvh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Eine ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BEj7lSFp3p"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Fixture","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fEiPJyRXN7"}],"key":"zdzetMxIq2"},{"type":"text","value":" ist eine Funktion die mit ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eTOTmU3ZOq"},{"type":"inlineCode","value":"@pytest.fixture","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"USCu7K181i"},{"type":"text","value":" dekoriert wird. pytest ruft sie automatisch auf und uebergibt ihr Ergebnis an den Test -- einfach indem man den Fixture-Namen als Parameter des Tests angibt.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZfM38S3YPe"}],"key":"Cxzd7zbulQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Das klingt wie Magie, ist aber simples Dependency Injection: pytest sieht dass ein Test einen Parameter mit dem Namen ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GOSH5Xaa0R"},{"type":"inlineCode","value":"standard_held","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aCErfV95Sx"},{"type":"text","value":" hat, sucht nach einer Fixture dieses Namens und reicht den Rueckgabewert weiter.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ymPV9txmZu"}],"key":"Nh1eofm6M9"}],"key":"DVuBRasUR9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Wir erweitern combat.py um eine Held-Klasse\nheld_klasse = '''\nfrom combat import berechne_schaden, heilen as heilen_fn, ist_besiegt, statuseffekt_anwenden\n\n\nclass Held:\n    def __init__(self, name, hp, max_hp, angriff, verteidigung):\n        self.name        = name\n        self.hp          = hp\n        self.max_hp      = max_hp\n        self.angriff     = angriff\n        self.verteidigung = verteidigung\n\n    def erleidet_schaden(self, schaden):\n        netto = berechne_schaden(schaden, self.verteidigung)\n        self.hp -= netto\n\n    def heilen(self, menge):\n        self.hp = heilen_fn(self.hp, self.max_hp, menge)\n\n    def ist_besiegt(self):\n        return ist_besiegt(self.hp)\n\n    def __repr__(self):\n        return f\"Held({self.name}, HP={self.hp}/{self.max_hp})\"\n'''\n\nwith open('held.py', 'w') as f:\n    f.write(held_klasse)\nprint('held.py erstellt')","key":"mvAUuy7oPm"},{"type":"outputs","id":"Cs_pNmruAUsmH9K7kHoWr","children":[],"key":"eI5r11eYOF"}],"key":"wqjmYeWeUJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"test_mit_fixtures = '''\nimport pytest\nfrom held import Held\n\n\n# Fixture: wird vor jedem Test der sie verwendet aufgerufen\n@pytest.fixture\ndef standard_held():\n    \"\"\"Ein frischer Held mit vollen HP fuer jeden Test.\"\"\"\n    return Held(name=\"Aldric\", hp=100, max_hp=100, angriff=15, verteidigung=5)\n\n\n@pytest.fixture\ndef verletzter_held():\n    \"\"\"Ein Held der bereits Schaden erlitten hat.\"\"\"\n    return Held(name=\"Lyria\", hp=30, max_hp=100, angriff=12, verteidigung=3)\n\n\n# Tests verwenden Fixture als Parameter -- pytest injiziert sie automatisch\ndef test_held_erhaelt_schaden(standard_held):\n    standard_held.erleidet_schaden(20)\n    # Nettoschaden: 20 - 5 (Verteidigung) = 15\n    assert standard_held.hp == 85\n\n\ndef test_held_wird_geheilt(verletzter_held):\n    verletzter_held.heilen(20)\n    assert verletzter_held.hp == 50\n\n\ndef test_held_heilung_cap(verletzter_held):\n    # Heilung weit ueber max_hp -- wird gekappt\n    verletzter_held.heilen(999)\n    assert verletzter_held.hp == 100\n\n\ndef test_held_ist_besiegt(standard_held):\n    standard_held.erleidet_schaden(999)\n    assert standard_held.ist_besiegt() == True\n\n\ndef test_held_lebt_noch(standard_held):\n    standard_held.erleidet_schaden(10)\n    assert standard_held.ist_besiegt() == False\n\n\ndef test_jeder_test_bekommt_frischen_held(standard_held):\n    # Dieser Test aendert den Held -- aber der naechste Test bekommt\n    # einen frischen Held, nicht diesen veraenderten\n    standard_held.erleidet_schaden(999)\n    assert standard_held.hp < 0\n'''\n\nwith open('test_held.py', 'w') as f:\n    f.write(test_mit_fixtures)\nprint('test_held.py erstellt')","key":"SNH8QKlN9C"},{"type":"outputs","id":"zsQ9Ltq_g2ZcfRohzT2uj","children":[],"key":"tcRdhyHBIw"}],"key":"aYdZifdkbQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import subprocess\nresult = subprocess.run(\n    ['python', '-m', 'pytest', 'test_held.py', '-v'],\n    capture_output=True, text=True\n)\nprint(result.stdout)","key":"I9FW0HGiWS"},{"type":"outputs","id":"RKmPr3rIt7yMN6HZKOI3A","children":[],"key":"eEgjTIEZ3m"}],"key":"GJL87CzdF7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Wichtig: pytest erstellt die Fixture ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kjVG4sNDEB"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"vor jedem Test neu","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SFcREeT0l4"}],"key":"wQvGKSnjCX"},{"type":"text","value":". ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F4dyg4v8OA"},{"type":"inlineCode","value":"test_held_ist_besiegt","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pzNVyuEQo9"},{"type":"text","value":" bekommt einen Held mit 100 HP -- nicht den Held mit 0 HP aus ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zahzky4LNd"},{"type":"inlineCode","value":"test_held_erhaelt_schaden","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ghnAO30CPB"},{"type":"text","value":". Jeder Test ist isoliert. Das ist das Kernprinzip.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fXyMiaj7xD"}],"key":"bK7V6uW9Is"}],"key":"nRwGBbIQOE"},{"type":"block","kind":"notebook-content","children":[{"type":"div","style":{"background":"#0b1929","borderLeft":"4px solid #4fc3f7","borderRadius":"4px","padding":"0.75em 1.2em","margin":"2rem 0 1.2rem 0","fontFamily":"'Segoe UI',sans-serif"},"children":[{"type":"span","style":{"fontSize":"clamp(1rem,2.2vw,1.25rem)","fontWeight":"600","color":"#e8eaf6","letterSpacing":"-0.01em"},"children":[{"type":"span","style":{"fontSize":"0.65rem","letterSpacing":"0.1em","textTransform":"uppercase","color":"#4fc3f7","background":"rgba(79,195,247,0.12)","border":"1px solid rgba(79,195,247,0.3)","borderRadius":"3px","padding":"0.2em 0.55em","marginRight":"0.75em","verticalAlign":"middle","whiteSpace":"nowrap"},"children":[{"type":"text","value":"Kursinhalt","key":"pcZ9fkSwex"}],"key":"aBaykMfA1Q"},{"type":"text","value":" 3. Parametrisierung -- einen Test mit vielen Eingaben","key":"HBQg056aQV"}],"key":"Obmw7E5BSn"}],"key":"etZHR2CQYG"}],"key":"GUIaHJ570L"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Schau dir die Tests fuer ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ootcTgAtM0"},{"type":"inlineCode","value":"berechne_schaden()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Je0vXlR9dO"},{"type":"text","value":" aus 10b an -- viele Tests die dasselbe pruefen, nur mit anderen Zahlen. Das ist ein weiteres Wiederholungsmuster.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GzVcbDAlho"}],"key":"Trt1ae1civ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"inlineCode","value":"@pytest.mark.parametrize","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YSgDmRZprT"},{"type":"text","value":" loest das: Man schreibt den Test einmal und gibt eine Liste von Eingabe-Erwartungs-Paaren mit. pytest fuehrt den Test automatisch fuer jede Kombination aus -- und zeigt jeden Fall einzeln in der Ausgabe.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YWpi9lknIQ"}],"key":"emnkyuy6e2"}],"key":"UEBXwRw6US"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"test_parametrize = '''\nimport pytest\nfrom combat import berechne_schaden, heilen, trefferchance, statuseffekt_anwenden\n\n\n# Ohne Parametrisierung: 4 separate Tests\ndef test_schaden_v1(): assert berechne_schaden(50, 20) == 30\ndef test_schaden_v2(): assert berechne_schaden(20, 20) == 1\ndef test_schaden_v3(): assert berechne_schaden(10, 50) == 1\ndef test_schaden_v4(): assert berechne_schaden(100, 0) == 100\n\n\n# Mit Parametrisierung: ein Test, vier Faelle\n# Format: \"angriff, verteidigung, erwartet\"\n@pytest.mark.parametrize(\"angriff, verteidigung, erwartet\", [\n    (50, 20, 30),   # Normalfall\n    (20, 20,  1),   # Grenzwert: gleiche Werte -> Mindestschaden\n    (10, 50,  1),   # Grenzwert: Verteidigung > Angriff -> Mindestschaden\n    (100, 0, 100),  # Grenzwert: keine Verteidigung\n    (1,   0,   1),  # Grenzwert: minimaler Angriff\n])\ndef test_berechne_schaden(angriff, verteidigung, erwartet):\n    assert berechne_schaden(angriff, verteidigung) == erwartet\n\n\n# Grenzwerte fuer trefferchance\n@pytest.mark.parametrize(\"angreifer, ziel, erwartet\", [\n    (10, 10,  50),   # gleich schnell\n    (10,  8,  60),   # etwas schneller\n    ( 1, 20,  10),   # Grenzwert: Minimum -- sehr langsam\n    (20,  1,  95),   # Grenzwert: Maximum -- sehr schnell\n    ( 2, 20,  10),   # Aequivalenzklasse: unter Minimum bleibt bei 10\n    (19,  1,  95),   # Aequivalenzklasse: ueber Maximum bleibt bei 95\n])\ndef test_trefferchance(angreifer, ziel, erwartet):\n    assert trefferchance(angreifer, ziel) == erwartet\n\n\n# Alle gueltigen Statuseffekte\n@pytest.mark.parametrize(\"effekt, schaden, erwartet\", [\n    (\"normal\",    20, 20),\n    (\"vergiftet\", 20, 30),\n    (\"geschwaeht\",20, 15),\n    (\"verstaerkt\",20, 40),\n    (\"vergiftet\",  0,  0),   # Grenzwert: Schaden = 0\n])\ndef test_statuseffekt_anwenden(effekt, schaden, erwartet):\n    assert statuseffekt_anwenden(schaden, effekt) == erwartet\n'''\n\nwith open('test_parametrize.py', 'w') as f:\n    f.write(test_parametrize)\nprint('test_parametrize.py erstellt')","key":"P6AR4VJKlH"},{"type":"outputs","id":"Xi6H-h-p8Fhq_Ge4uOgRU","children":[],"key":"AR6UiYRxrE"}],"key":"NCZ6Pv3CUP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import subprocess\nresult = subprocess.run(\n    ['python', '-m', 'pytest', 'test_parametrize.py', '-v'],\n    capture_output=True, text=True\n)\nprint(result.stdout)","key":"znxo7E5Qsr"},{"type":"outputs","id":"eoQ0C1k___-lH7wwpaEl_","children":[],"key":"UuID6XU3Ca"}],"key":"BwMPNFlxJv"},{"